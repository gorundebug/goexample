go 1.25.4

use (
	./analyticsservice
	./automationservice
	./inventory_service_api
	./inventoryservice
	./model_go
	./order_service_api
	./orderservice
)

// Keep the hybrid workspace reproducible before its sibling modules are
// published. The version-qualified replacements apply only while GOWORK points
// at this file; autonomous service builds use their pinned repositories.
replace (
	github.com/gorundebug/inventory_service_api v0.2.99 => ./inventory_service_api
	github.com/gorundebug/model_go v0.2.99 => ./model_go
	github.com/gorundebug/order_service_api v0.2.99 => ./order_service_api
)
