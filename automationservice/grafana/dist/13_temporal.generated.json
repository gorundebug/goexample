{
   "panels": [
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 0,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "panels": [ ],
         "title": "Temporal Server",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "sum(rate(service_requests{telemetry_source=\"temporal-server\", job=~\"$server_job\"}[$__rate_interval])) by (operation)",
               "intervalFactor": 2,
               "legendFormat": "{{operation}}"
            }
         ],
         "title": "Frontend Request Rate",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 1
         },
         "id": 3,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "sum(rate({__name__=~\"service_errors.*\", telemetry_source=\"temporal-server\", job=~\"$server_job\"}[$__rate_interval])) by (__name__, operation)",
               "intervalFactor": 2,
               "legendFormat": "{{__name__}} {{operation}}"
            }
         ],
         "title": "Server Error Rate",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 0,
            "x": 24,
            "y": 9
         },
         "id": 4,
         "panels": [ ],
         "title": "Official SDK / Worker",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 10
         },
         "id": 5,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "sum(temporal_worker_task_slots_used{telemetry_source=\"temporal-sdk\", job=~\"$sdk_job\", task_queue=~\"$task_queue\"}) by (worker_type, task_queue)",
               "intervalFactor": 2,
               "legendFormat": "used {{worker_type}} / {{task_queue}}"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "sum(temporal_worker_task_slots_available{telemetry_source=\"temporal-sdk\", job=~\"$sdk_job\", task_queue=~\"$task_queue\"}) by (worker_type, task_queue)",
               "intervalFactor": 2,
               "legendFormat": "available {{worker_type}} / {{task_queue}}"
            }
         ],
         "title": "Worker Slots Used / Available",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 18
         },
         "id": 6,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "histogram_quantile(0.5, sum(rate(temporal_request_latency_seconds_bucket{telemetry_source=\"temporal-sdk\", job=~\"$sdk_job\"}[$__rate_interval])) by (le, operation))",
               "intervalFactor": 2,
               "legendFormat": "p50 {{operation}}"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "histogram_quantile(0.95, sum(rate(temporal_request_latency_seconds_bucket{telemetry_source=\"temporal-sdk\", job=~\"$sdk_job\"}[$__rate_interval])) by (le, operation))",
               "intervalFactor": 2,
               "legendFormat": "p95 {{operation}}"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "histogram_quantile(0.99, sum(rate(temporal_request_latency_seconds_bucket{telemetry_source=\"temporal-sdk\", job=~\"$sdk_job\"}[$__rate_interval])) by (le, operation))",
               "intervalFactor": 2,
               "legendFormat": "p99 {{operation}}"
            }
         ],
         "title": "Temporal Client Request Latency p50 / p95 / p99",
         "type": "timeseries"
      },
