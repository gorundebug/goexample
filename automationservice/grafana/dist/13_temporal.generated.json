   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "servicelib",
      "temporal",
      "durable-call"
   ],
   "templating": {
      "list": [
         {
            "label": "Datasource",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Server_job",
            "multi": true,
            "name": "server_job",
            "query": "label_values(service_requests{telemetry_source=\"temporal-server\"}, job)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Sdk_job",
            "multi": true,
            "name": "sdk_job",
            "query": "label_values(temporal_worker_task_slots_available{telemetry_source=\"temporal-sdk\"}, job)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Task_queue",
            "multi": true,
            "name": "task_queue",
            "query": "label_values(temporal_worker_task_slots_available{telemetry_source=\"temporal-sdk\", job=~\"$sdk_job\"}, task_queue)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Service",
            "multi": true,
            "name": "service",
            "query": "label_values(service_info, service)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "From",
            "multi": true,
            "name": "from",
            "query": "label_values(stream_messages_total{service=~\"$service\"}, from)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "To",
            "multi": true,
            "name": "to",
            "query": "label_values(stream_messages_total{service=~\"$service\", from=~\"$from\"}, to)",
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "automationservice / Temporal & DurableCall",
   "uid": "automationservice-temporal"
}
